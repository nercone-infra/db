# RucoNet (docker compose run --rm ruconet ruconet-hub keygen <name> in the ruconet repository)
RUCONET_PRIVATE_KEY=
RUCONET_PRESHARED_KEY=
RUCONET_HUB_PUBLIC_KEY=

# PostgreSQL
POSTGRES_PASSWORD=

# Must match GITEA_DB_PASSWORD in the gitea repository
GITEA_DB_PASSWORD=

# Must match MAIL_DB_PASSWORD and ROUNDCUBE_DB_PASSWORD in the mail repository
MAIL_DB_PASSWORD=
ROUNDCUBE_DB_PASSWORD=
